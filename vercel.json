{
  "version": 2,
  "regions": [
    "icn1"
  ],
  "buildCommand": "npm run build:css",
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/index.js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "api/index.js"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/sync-church-staff",
      "schedule": "0 18 * * *"
    }
  ]
}
